#!/command/with-contenv sh
# shellcheck shell=sh

set -eu

. /usr/local/bin/backend-functions

SCRIPT_NAME="INIT-FIREWALL"

log "$SCRIPT_NAME" "Starting firewall initialization"
log "$SCRIPT_NAME" "Configuring firewall to route all traffic through VPN"

# BusyBox-friendly helpers
docker_network="$(ip addr show dev "$wan_if" 2>/dev/null | awk '/inet / {print $2; exit}')"
gw="$(ip route 2>/dev/null | awk '/default/ {print $3; exit}')"

# ===================== IPv4 =====================
if [ -n "$docker_network" ]; then
    log "$SCRIPT_NAME" "Setting up IPv4 firewall rules..."

    # Stateful fast-path (skip gracefully if conntrack match absent)
    run4_critical -A INPUT  -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    run4_critical -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

    # Allow outbound to VPN interfaces + NAT
    run4_critical -A OUTPUT -o "$tun_if" -j ACCEPT
    run4_critical -t nat -A POSTROUTING -o "$tun_if" -j MASQUERADE

    # Create named chain for VPN Server rules
    run4 -N VPN-SERVER
    run4 -A OUTPUT -o "$wan_if" -p udp --dport 51820 -j VPN-SERVER

    # NordVPN API bootstrap (TCP/443) by resolved IPs
    if [ -n "$nordvpnapi_ip" ]; then
        log "$SCRIPT_NAME" "Allowing NordVPN API access for IPs: ${nordvpnapi_ip}"
        oldIFS="$IFS"; IFS=',;'
        for ip in $nordvpnapi_ip; do
            [ -z "$ip" ] && continue
            run4 -A OUTPUT -d "$ip" -p tcp --dport 443 -j ACCEPT
            # Pin a host route via eth0 so API traffic stays off the tunnel.
            # wg-quick's policy routing sends everything through wg0, but its
            # 'suppress_prefixlength 0' rule lets specific main-table routes
            # win. Without this route a dead tunnel makes the API unreachable,
            # and vpn-reconnect can never fetch the key/server list to recover.
            if [ -n "$gw" ]; then
                ip route add "$ip" via "$gw" dev "$wan_if" 2>/dev/null || true
            fi
        done
        IFS="$oldIFS"
    fi

    # NETWORK rules (CIDRs). If present, restrict inbound to these nets; do NOT add the broad eth0 accept.
    if [ -n "${network:-}" ]; then
        log "$SCRIPT_NAME" "Allowing access to custom networks: ${network}"
        oldIFS="$IFS"; IFS=',;'
        for net in $network; do
            [ -z "$net" ] && continue
            # Best-effort route add (if not already present)
            if [ -n "$gw" ]; then
                ip route 2>/dev/null | grep -q " ${net} " || ip route add "$net" via "$gw" dev "$wan_if" 2>/dev/null || true
            fi
            # Allow inbound from this network only
            run4 -A INPUT -i "$wan_if" -s "$net" -j ACCEPT
            # Allow outbound to this network only
            run4 -A OUTPUT -o "$wan_if" -d "$net" -j ACCEPT
        done
        IFS="$oldIFS"
    fi

    # FORWARD_FROM rules (CIDRs). Downstream subnets allowed to route OUT through
    # the tunnel (e.g. a VPN server living behind us). Traffic must arrive already
    # SNATed into one of these nets so no return route is required. Semicolon- or
    # comma-separated; only FORWARD is opened — INPUT/OUTPUT stay locked, so if the
    # tunnel is down these rules cannot match and nothing leaks.
    if [ -n "${forward_from:-}" ]; then
        log "$SCRIPT_NAME" "Allowing tunnel forwarding from: ${forward_from}"
        oldIFS="$IFS"; IFS=',;'
        for net in $forward_from; do
            [ -z "$net" ] && continue
            run4_critical -A FORWARD -s "$net" -o "$tun_if" -j ACCEPT
            run4_critical -A FORWARD -d "$net" -i "$tun_if" \
                -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
        done
        IFS="$oldIFS"
    fi

    # Gateway-client DNS interception (GATEWAY_DNS), ported from the sibling
    # openconnect-client image. Applies to the FORWARD_FROM clients:
    #   redirect  DNAT port 53 to the first IPv4 resolver of DNS, so clients
    #             resolve through the tunnel like the container itself
    #   local     DNAT port 53 to this container, for a co-located resolver
    #             (AdGuard Home, Pi-hole) in network_mode: service:vpn
    #   forward   DNAT port 53 to GATEWAY_DNS_SERVER, reached directly over
    #             the uplink (not the tunnel) - e.g. a LAN AdGuard
    #   off       no interception (default)
    case "$gateway_dns" in
        redirect|local|forward|off) ;;
        *)
            log_error "$SCRIPT_NAME" "CRITICAL ERROR: GATEWAY_DNS must be redirect, local, forward or off (got '$gateway_dns') - sleeping infinite"
            sleep infinity
            ;;
    esac
    if [ "$gateway_dns" != "off" ] && [ -z "${forward_from:-}" ]; then
        log_warning "$SCRIPT_NAME" "GATEWAY_DNS=$gateway_dns ignored: FORWARD_FROM is not set"
    elif [ "$gateway_dns" != "off" ]; then
        dns_target=""
        case "$gateway_dns" in
            redirect)
                dns_target="$(echo "$dns" | tr ',;' '\n' | grep -v ':' | head -1)"
                if [ -z "$dns_target" ]; then
                    log_error "$SCRIPT_NAME" "CRITICAL ERROR: GATEWAY_DNS=redirect found no IPv4 resolver in DNS ('$dns') - sleeping infinite"
                    sleep infinity
                fi
                ;;
            forward)
                dns_target="$(echo "$gateway_dns_server" | tr ',;' '\n' | grep -v ':' | head -1)"
                if [ -z "$dns_target" ]; then
                    log_error "$SCRIPT_NAME" "CRITICAL ERROR: GATEWAY_DNS=forward requires an IPv4 GATEWAY_DNS_SERVER - sleeping infinite"
                    sleep infinity
                fi
                ;;
        esac
        log "$SCRIPT_NAME" "Intercepting client DNS: mode=${gateway_dns}${dns_target:+ target=$dns_target}"
        oldIFS="$IFS"; IFS=',;'
        for net in $forward_from; do
            [ -z "$net" ] && continue
            for proto in udp tcp; do
                case "$gateway_dns" in
                    redirect)
                        # addrtype ! LOCAL: queries deliberately aimed at an
                        # address inside this netns (a co-located resolver)
                        # pass untouched
                        run4_critical -t nat -A PREROUTING -i "$wan_if" -s "$net" \
                            -p "$proto" --dport 53 -m addrtype ! --dst-type LOCAL \
                            -j DNAT --to-destination "${dns_target}:53"
                        ;;
                    local)
                        run4_critical -t nat -A PREROUTING -i "$wan_if" -s "$net" \
                            -p "$proto" --dport 53 -j REDIRECT
                        run4_critical -A INPUT -i "$wan_if" -s "$net" \
                            -p "$proto" --dport 53 -j ACCEPT
                        ;;
                    forward)
                        run4_critical -t nat -A PREROUTING -i "$wan_if" -s "$net" \
                            -p "$proto" --dport 53 -j DNAT --to-destination "${dns_target}:53"
                        run4_critical -A FORWARD -i "$wan_if" -o "$wan_if" -s "$net" \
                            -d "$dns_target" -p "$proto" --dport 53 -j ACCEPT
                        ;;
                esac
            done
        done
        IFS="$oldIFS"
        if [ "$gateway_dns" = "forward" ]; then
            # Hairpin: DNATed queries go back out the uplink; masquerade so
            # the resolver replies to the gateway, and pin a host route so
            # wg-quick's policy routing cannot hijack it (same mechanism as
            # the API pin above). A directly-connected resolver needs no pin.
            run4_critical -A FORWARD -i "$wan_if" -o "$wan_if" \
                -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
            run4_critical -t nat -A POSTROUTING -o "$wan_if" -d "$dns_target" -j MASQUERADE
            case "$(ip route get "$dns_target" 2>/dev/null | head -1)" in
                *" via "*)
                    if [ -n "$gw" ]; then
                        ip route add "$dns_target" via "$gw" dev "$wan_if" 2>/dev/null || true
                    fi
                    ;;
            esac
        fi
    fi
else
    log "$SCRIPT_NAME" "No IPv4 address on ${wan_if}, skipping IPv4 rules"
fi

log "$SCRIPT_NAME" "Firewall initialization completed"
exit 0
